# ============================================================
# Velora — variables d'environnement
# Copier en .env et remplir. Ne JAMAIS committer .env.
# ============================================================

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Supabase ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Shopify · transition depuis la boutique existante ───
# Le catalogue s'aspire SANS identifiant (scripts/import-shopify-catalog.mjs).
# Les commandes exigent un token Admin API. Procédure : app personnalisée
# Shopify, scopes read_orders + read_customers + read_products, puis coller le
# token « shpat_… » ci-dessous. Ne jamais committer ce token.
SHOPIFY_STORE_DOMAIN=jngiej-ax.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2024-10

# ─── Upstash Redis · bans et rate limiting ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Tracking ───
# ATTENTION : ces identifiants sont GLOBAUX, partagés par tous les marchés
# (BJ, CI, GA). Ils ne sont volontairement pas dans market_config.
META_PIXEL_ID=
META_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
SNAPCHAT_PIXEL_ID=
SNAPCHAT_ACCESS_TOKEN=

# ─── Anti-fraude ───
FINGERPRINTJS_API_KEY=
IPQUALITYSCORE_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

# shadow : score et journalise, ne bloque pas (défaut, et fortement recommandé
# tant que la distribution réelle des scores n'a pas été observée — voir
# packages/fraud/src/index.ts).
# active : applique blocages et blacklists automatiques.
FRAUD_ENFORCEMENT=shadow
