# ============================================================
# Velora — variables d'environnement
# Copier en .env et remplir. Ne JAMAIS committer .env.
# ============================================================

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Supabase ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Shopify · MIGRATION ONE-SHOT UNIQUEMENT ───
# L'API runtime ne dépend PAS de Shopify. Ces variables ne servent qu'aux
# scripts de migration, exécutés une seule fois avant de couper Shopify :
#   - catalogue : scripts/import-shopify-catalog.mjs (domaine seul suffit)
#   - commandes : scripts/migrate-shopify-orders.mjs (token requis, usage unique)
# Token : app personnalisée Shopify, scopes read_orders + read_customers.
# Ne jamais committer le token.
SHOPIFY_STORE_DOMAIN=jngiej-ax.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2024-10

# ─── Upstash Redis · bans et rate limiting ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Tracking ───
# ATTENTION : ces identifiants sont GLOBAUX, partagés par tous les marchés
# (BJ, CI, GA). Ils ne sont volontairement pas dans market_config.
META_PIXEL_ID=
META_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
SNAPCHAT_PIXEL_ID=
SNAPCHAT_ACCESS_TOKEN=

# ─── Anti-fraude ───
FINGERPRINTJS_API_KEY=
IPQUALITYSCORE_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

# shadow : score et journalise, ne bloque pas (défaut, et fortement recommandé
# tant que la distribution réelle des scores n'a pas été observée — voir
# packages/fraud/src/index.ts).
# active : applique blocages et blacklists automatiques.
FRAUD_ENFORCEMENT=shadow
